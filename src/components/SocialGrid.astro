<script is:inline>
  document.getElementById("exclusiveCardLink")?.addEventListener("click", (e) => {
    e.preventDefault();
    const disclaimer = document.getElementById("ofDisclaimer");
    if (disclaimer) disclaimer.classList.add("active");
  });

  document.getElementById("disclaimerBtnContinue")?.addEventListener("click", (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (typeof fbq === 'function') fbq('trackCustom', 'Confirmed18Plus');
    window.open("https://blog.sofia-gonzalez.online/", "_blank", "noopener");
  });

  document.getElementById("digitalPacksLink")?.addEventListener("click", (e) => {
    e.preventDefault();
    if (window.abrirProximamente) window.abrirProximamente(e);
  });
</script>
