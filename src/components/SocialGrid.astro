---
---
<p class="bio" id="bio" data-i18n="bio">Escríbeme por DM en mi página ❤</p>

<section class="social-section">
  <!-- Contenido Exclusivo 18+ (Tarjeta Destacada Ancho Completo) -->
  <a class="card full-width" href="#" id="exclusiveCardLink">
    <img src="/img/imagen1.webp" alt="Contenido exclusivo" loading="lazy" decoding="async" width="800" height="450" data-i18n-alt="exclusiveAlt" />
    <div class="shade"></div>
    
    <!-- Aviso de Contenido Adulto (In-Card Blur) -->
    <div class="disclaimer-overlay" id="ofDisclaimer">
      <div class="disclaimer-content">
        <svg class="disclaimer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
          <line x1="1" y1="1" x2="23" y2="23"></line>
        </svg>
        <div class="disclaimer-title" data-i18n="disclaimerTitle">Aviso de contenido adulto</div>
        <div class="disclaimer-text" data-i18n="disclaimerText">Este enlace puede contener contenido gráfico o para adultos.</div>
        <button class="disclaimer-btn" type="button" id="disclaimerBtnContinue" data-i18n="disclaimerBtn">Continuar (18+)</button>
      </div>
    </div>
    
    <span class="corner social-badge-of">
      <img src="/img/icono.webp" alt="Icono" loading="lazy" decoding="async" width="120" height="120" style="width:100%;height:100%;object-fit:cover;display:block;" />
    </span>
    <span class="label" data-i18n="exclusiveCard">Contenido exclusivo</span>
    <span class="tap-hint" data-i18n="tapHint"> 👆 Toca aquí</span>
  </a>

  <!-- Columnas Pinterest Equilibradas -->
  <div class="pinterest-columns">
    <!-- Columna Izquierda -->
    <div class="pin-col">
      <!-- Instagram -->
      <a class="card" href="https://www.instagram.com/sofiagonzalez230s/" target="_blank" rel="noopener">
